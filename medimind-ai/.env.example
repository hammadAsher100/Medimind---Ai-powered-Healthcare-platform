# ── MediMind AI Environment Variables ─────────────────
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.

# ── Django ────────────────────────────────────────────
DJANGO_SECRET_KEY="change-this-to-a-long-random-string-in-production"
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_SETTINGS_MODULE=medimind.settings.development

# ── PostgreSQL (Docker only — uses SQLite locally) ────
POSTGRES_DB=medimind_db
POSTGRES_USER=medimind_user
POSTGRES_PASSWORD=change-this-to-a-strong-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── Qdrant (vector DB for RAG — optional) ─────────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=medimind_knowledge

# ── LLM API Keys (at least one required for AI chat) ──
# Primary LLM (Groq — llama-3.3-70b-versatile)
# Get your key at https://console.groq.com
GROQ_API_KEY="your_groq_api_key_here"

# Fallback LLM (OpenRouter — optional)
OPENROUTER_API_KEY="your_openrouter_api_key_here"
OPENROUTER_MODEL=mistralai/mistral-small-24b-instruct-2501

# Alternative LLM (Mistral — optional)
MISTRAL_API_KEY="your_mistral_api_key_here"

# ── Embeddings (Cohere — required for RAG/Qdrant) ─────
COHERE_API_KEY="your_cohere_api_key_here"

# ── Hugging Face (optional, for model hub access) ─────
HF_API_KEY="your_huggingface_api_key_here"

# ── MLflow (optional for experiment tracking) ─────────
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_ARTIFACT_ROOT=/mlartifacts

# ── Service URLs ──────────────────────────────────────
FASTAPI_URL=http://fastapi:8001
DJANGO_INTERNAL_API_URL=http://django:8000

# Internal auth token between services
DJANGO_SERVICE_TOKEN=change-this-to-a-random-hex-string

# ── Feature Flags ─────────────────────────────────────
DISABLE_ML=False
DISABLE_CNN=False
DISABLE_QDRANT=True
DISABLE_MLFLOW=True

# ── Grafana ───────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-to-a-strong-password
