# ── MediMind AI Environment Variables ─────────────────
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.

# ── Django ────────────────────────────────────────────
DJANGO_SECRET_KEY="change-this-to-a-long-random-string-in-production"
# Optional comma-separated Fernet keys. The first key encrypts new data and
# remaining keys allow safe rotation. If empty, DJANGO_SECRET_KEY is used to
# derive a stable field-encryption key.
FIELD_ENCRYPTION_KEYS=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=medimind-ai.online,www.medimind-ai.online,app.medimind-ai.online
DJANGO_SETTINGS_MODULE=medimind.settings.production

# Social login (server-side secrets; configure in EC2 .env, never in Git).
# Google callback: https://app.medimind-ai.online/accounts/google/login/callback/
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Optional bot protection for password login and registration.
TURNSTILE_ENABLED=False
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Production HTTPS settings. Comma-separated values are parsed by Django.
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=300
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
CSRF_TRUSTED_ORIGINS=https://medimind-ai.online,https://www.medimind-ai.online,https://app.medimind-ai.online
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://medimind-ai.online,https://www.medimind-ai.online,https://app.medimind-ai.online

# ── On-demand EC2 activity tracking ────────────────────
# Enable only after the on-demand CloudFormation stack and EC2 IAM policy exist.
ACTIVITY_TRACKING_ENABLED=False
ACTIVITY_TABLE_NAME=
EC2_INSTANCE_ID=
AWS_REGION=ap-south-1
ACTIVITY_TOUCH_INTERVAL_SECONDS=30
ACTIVITY_LEASE_SECONDS=900

# Nginx origin certificate used after app.medimind-ai.online DNS is active.
CERTBOT_CERT_NAME=app.medimind-ai.online

# ── PostgreSQL (Docker only — uses SQLite locally) ────
POSTGRES_DB=medimind_db
POSTGRES_USER=medimind_user
POSTGRES_PASSWORD=change-this-to-a-strong-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── Qdrant (vector DB for RAG — optional) ─────────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=medimind_knowledge

# ── LLM API Keys (at least one required for AI chat) ──
# Primary LLM (Groq — llama-3.3-70b-versatile)
# Get your key at https://console.groq.com
GROQ_API_KEY="your_groq_api_key_here"

# Fallback LLM (OpenRouter — optional)
OPENROUTER_API_KEY="your_openrouter_api_key_here"
OPENROUTER_MODEL=mistralai/mistral-small-24b-instruct-2501

# Alternative LLM (Mistral — optional)
MISTRAL_API_KEY="your_mistral_api_key_here"

# ── Embeddings (Cohere — required for RAG/Qdrant) ─────
COHERE_API_KEY="your_cohere_api_key_here"

# ── Hugging Face (optional, for model hub access) ─────
HF_API_KEY="your_huggingface_api_key_here"

# ── MLflow (optional for experiment tracking) ─────────
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_ARTIFACT_ROOT=/mlartifacts

# ── Service URLs ──────────────────────────────────────
FASTAPI_URL=http://fastapi:8001
DJANGO_INTERNAL_API_URL=http://django:8000
FASTAPI_CORS_ORIGINS=https://medimind-ai.online,https://www.medimind-ai.online,https://app.medimind-ai.online

# Internal auth token between services
DJANGO_SERVICE_TOKEN=change-this-to-a-random-hex-string

# ── Feature Flags ─────────────────────────────────────
DISABLE_ML=False
DISABLE_CNN=False
DISABLE_QDRANT=True
DISABLE_MLFLOW=True

# ── Grafana ───────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-to-a-strong-password
